rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - Private (user can only access their own data)
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.id;
    }
    
    // Destinations collection - Public (read by all, write by authenticated users)
    match /destinations/{destinationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Features collection - Public (read by all, write by authenticated users)
    match /features/{featureId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
